const mongoose = require('mongoose')
const Schema = mongoose.Schema

const productSchema = new Schema({
  name: {
    type: String,
    required: true
  },
  description: {
    type: String,
    required: true
  },
  price: {
    type: Number,
    required: true
  },
  stock: {
    type: Number,
    required: true
  },
  image: {
    type: String,
    requried: true
  },
  createdAt: {
    type: Date,
    default: Date.now,
    required: true
  }
})

const Product = mongoose.model('Product', productSchema)

module.exports = Product